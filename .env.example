# Display name used across the UI, page titles and the PWA manifest.
NEXT_PUBLIC_APP_NAME=Printle
# Short tagline on the home screen.
NEXT_PUBLIC_APP_TAGLINE=Scan the number at any print shop, pick your files, and send them on WhatsApp.
# Default region for parsing numbers without a country code (ISO 3166-1 alpha-2).
NEXT_PUBLIC_DEFAULT_REGION=IN
